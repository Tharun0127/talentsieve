# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
JWT_SECRET=change-me-in-production

# Leave empty to use the built-in MockLLM (no key, no cost).
ANTHROPIC_API_KEY=
# auto = Anthropic if a key is set, otherwise mock. Or force: mock | anthropic
LLM_PROVIDER=auto

# MockLLM behaviour
MOCK_LLM_MIN_DELAY=0.5
MOCK_LLM_MAX_DELAY=2.0
MOCK_LLM_FAILURE_RATE=0.1

# Global limit across ALL workers together
LLM_RATE_LIMIT_PER_MINUTE=120
# Jobs one worker process runs at the same time
WORKER_CONCURRENCY=4
